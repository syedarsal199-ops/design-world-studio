# Required for the AI chat widget (components/ChatWidget.tsx + app/api/chat/route.ts)
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Required for the Contact page form and "Start a Project" widgets (app/api/contact/route.ts)
# Get a free key at https://resend.com/api-keys (no domain verification needed to start —
# emails send from onboarding@resend.dev straight to CONTACT_TO_EMAIL below)
RESEND_API_KEY=re_your-key-here

# The inbox that should receive new project inquiries
CONTACT_TO_EMAIL=you@example.com

# Optional: Telegram alerts when someone visits the site (app/api/visitor-alert/route.ts)
# 1. Message @BotFather on Telegram, send /newbot, follow the prompts, copy the token
# 2. Message your new bot once (say "hi") so it is allowed to message you back
# 3. Message @userinfobot to get your numeric chat id
TELEGRAM_BOT_TOKEN=123456789:your-bot-token-here
TELEGRAM_CHAT_ID=123456789

# How noisy alerts should be:
#   all      - every pageview (default)
#   sessions - one alert per visit, on the first page they land on
#   intent   - only high-value pages (contact, services) and returning visitors
VISITOR_ALERT_MODE=all
